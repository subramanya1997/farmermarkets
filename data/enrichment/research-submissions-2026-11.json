      "faq_facts": [
        {
          "id": "where-and-when",
          "value": {
            "topic": "arrival",
            "answer": "The main store is at 3440 Piety St, New Orleans, open Sunday to Thursday, 10am to 4pm, all year. Barcelo Gardens also sets up at 2301 Gallier St in New Orleans on Saturdays, 10am to 1pm, and at 211 Franklin Ave in Napoleonville on Fridays, 11am to 2pm."
          },
          "source_ids": [
            "owner-facebook"
          ],
          "verified_at": "2026-11-12"
        },
        {
          "id": "what-is-sold",
          "value": {
            "topic": "products",
            "answer": "Fruits, vegetables and herbs from the garden and a network of local farmers, plus local honey, jams, butters, pepper jelly, sourdough, hot sauce, grits and homemade lemonade."
          },
          "source_ids": [
            "owner-facebook"
          ],
          "verified_at": "2026-11-12"
        },
        {
          "id": "benefits",
          "value": {
            "topic": "payments",
            "answer": "The market accepts WIC and Farmers Market Nutrition Program benefits and takes part in Greaux the Good Match. Orders can also be delivered through Uber Eats."
          },
          "source_ids": [
            "owner-facebook"
          ],
