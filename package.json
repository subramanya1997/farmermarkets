{
  "name": "farmermarkets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "assets:favicons": "node scripts/generate-favicons.mjs",
    "assets:og": "node scripts/generate-og-image.mjs",
    "data:update": "node scripts/update-government-markets.mjs && npm run data:consolidate && npm run data:geo",
    "data:update-legacy": "node --max-old-space-size=4096 scripts/update-legacy-markets.mjs && npm run data:consolidate && npm run data:geo",
    "data:check": "node scripts/check-government-markets.mjs",
    "data:archives:create": "node scripts/archive-enrichment-audits.mjs --create",
    "data:archives:check": "node scripts/archive-enrichment-audits.mjs --check",
    "data:archives:refresh": "node scripts/archive-enrichment-audits.mjs --create --replace",
    "data:archives:restore": "node scripts/archive-enrichment-audits.mjs --restore",
    "data:consolidate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-consolidated-markets.mjs",
    "data:consolidate:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-consolidated-markets.mjs --check",
    "data:enrichment": "npm run data:consolidate",
    "data:enrichment:check": "npm run data:consolidate:check",
    "data:enrichment:audit:prepare": "node scripts/prepare-enrichment-audit.mjs",
    "data:enrichment:audit:progress": "node scripts/validate-enrichment-audit.mjs --progress --write-report",
    "data:enrichment:audit:compile": "node scripts/validate-enrichment-audit.mjs && node scripts/compile-enrichment-audit.mjs && npm run data:consolidate",
    "data:enrichment:audit:check": "node scripts/validate-enrichment-audit.mjs",
    "data:website-audit:prepare": "node scripts/prepare-website-audit.mjs",
    "data:website-audit:reconcile": "node scripts/reconcile-website-audit.mjs",
    "data:website-audit:check": "node scripts/prepare-website-audit.mjs --check",
    "data:website-audit:run": "node scripts/run-website-audit-worker.mjs",
    "data:website-audit:progress": "node scripts/validate-website-audit.mjs --progress --write-report",
    "data:website-detail:run": "node scripts/run-website-detail-worker.mjs",
    "data:website-detail:progress": "node scripts/validate-website-detail-audit.mjs --progress --write-report",
    "data:website-audit:promote": "node scripts/promote-website-audit.mjs",
    "data:geo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-geo-index.mjs",
    "indexnow:ping": "node scripts/indexnow-ping.mjs",
    "test": "bun run test:data && bun run test:data-legacy && bun run test:enrichment && bun run test:enrichment-merge && bun run test:website-audit && bun run test:geo && bun run test:popup && bun run test:seo-meta && bun run test:topic-copy && bun run test:schema && bun run test:market-facts && bun run test:indexnow && bun run test:freshness && bun run test:site && bun run test:seo",
    "test:data": "node --test scripts/update-government-markets.test.mjs",
    "test:data-legacy": "node --test scripts/update-legacy-markets.test.mjs",
    "test:enrichment": "node --test scripts/lib/enrichment-audit-quality.test.mjs && npm run data:archives:check && npm run data:consolidate:check",
    "test:enrichment-merge": "bun test src/app/api/markets/data.test.ts",
    "test:website-audit": "node --test scripts/lib/website-audit.test.mjs scripts/lib/website-detail-audit.test.mjs scripts/lib/rich-enrichment-validation.test.mjs scripts/promote-website-audit.test.mjs",
    "test:indexnow": "node --test scripts/indexnow-ping.test.mjs",
    "test:geo": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-geo-index.test.mjs",
    "test:market-routes": "node scripts/check-market-routes.mjs",
    "test:topic-routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-topic-pages.mjs",
    "test:popup": "node --test --experimental-strip-types src/components/leafletPopupHtml.test.ts",
    "test:seo-meta": "node --test --experimental-strip-types src/lib/seo.test.ts",
    "test:topic-copy": "node --test --experimental-strip-types src/lib/topicCopy.test.ts",
    "test:schema": "node --test --experimental-strip-types src/lib/schema.test.ts",
    "test:market-facts": "node --test --experimental-strip-types src/lib/marketFacts.test.ts",
    "test:freshness": "node --test --experimental-strip-types src/lib/freshness.test.ts",
    "test:site": "node --test --experimental-strip-types src/lib/site.test.ts",
    "test:seo": "node --test scripts/seo-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.21.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
